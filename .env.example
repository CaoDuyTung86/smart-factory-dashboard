# Edge gateway doc PLC that qua Modbus TCP (xem infra/README.md).
# De trong -> tab PLC chay logic mo phong ngay trong trinh duyet.
# Chay stack bang: docker compose -f infra/docker-compose.yml up -d --build
VITE_PLC_GATEWAY_URL=

# Service AOI chay OpenCV (xem infra/README.md).
# De trong -> tab Vision chay du lieu mo phong nhu truoc.
VITE_VISION_API_URL=

# Backend MES + historian (xem infra/README.md).
# De trong -> tab SCADA chay simulator trong trinh duyet va tab MES hien du
# lieu mau; khong co request nao duoc gui di.
VITE_MES_API_URL=
