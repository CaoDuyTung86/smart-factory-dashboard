{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "tailwindCSS.experimental.classRegex": [
    "className:\\s*\"([^\"]*)\"",
    "className:\\s*'([^']*)'",
    "tdClassName:\\s*\"([^\"]*)\"",
    "tdClassName:\\s*'([^']*)'",
    "thClassName:\\s*\"([^\"]*)\"",
    "thClassName:\\s*'([^']*)'"
  ],
  // SpecStory: tắt hẳn cho workspace này. cloudSync chặn đồng bộ lên cloud,
  // autoSave chặn việc ghi lịch sử chat vào .specstory/ trong repo.
  "specstory.cloudSync.enabled": "never",
  "specstory.autoSave.enabled": false
}
